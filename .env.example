# Copie para .env e preencha os segredos, ou execute make env.
# Variáveis são compartilhadas por GNU Make e Docker Compose.
DATABASE_PASSWORD=
JWT_SECRET=

# Portas locais da infraestrutura (Make deriva os endereços da aplicação).
POSTGRES_PORT=5432
REDIS_PORT=6379
KAFKA_PORT=9092
SERVER_PORT=8080

# Configuração da API.
JWT_ISSUER=template
JWT_ACCESS_TOKEN_TTL=PT15M
CORS_ALLOWED_ORIGINS=
OPENAPI_ENABLED=true
DOCKER_COMPOSE_ENABLED=false
